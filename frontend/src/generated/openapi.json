{
  "components": {
    "schemas": {
      "EntrypointParameter": {
        "description": "One parameter of a method; only keyword arguments can be passed (as in JSON-2).",
        "properties": {
          "annotation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Annotation"
          },
          "default": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "required": {
            "title": "Required",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "kind",
          "required",
          "default",
          "annotation"
        ],
        "title": "EntrypointParameter",
        "type": "object"
      },
      "EntrypointSignature": {
        "description": "What a method expects, so a trace can be started with the right kwargs.",
        "properties": {
          "method": {
            "title": "Method",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "model_level": {
            "title": "Model Level",
            "type": "boolean"
          },
          "module": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Module"
          },
          "parameters": {
            "items": {
              "$ref": "#/components/schemas/EntrypointParameter"
            },
            "title": "Parameters",
            "type": "array"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          }
        },
        "required": [
          "model",
          "method",
          "model_level",
          "module",
          "summary",
          "parameters"
        ],
        "title": "EntrypointSignature",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Body of every error response: ``HTTPException(detail=...)`` renders as this.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "OdooConnectionStatus": {
        "description": "Result of checking the configured connection to the user's Odoo.\n\n``ok`` is true only if every check passed. ``problems`` explain what blocks tracing,\n``warnings`` what could not be verified.",
        "properties": {
          "addon_installed": {
            "default": false,
            "title": "Addon Installed",
            "type": "boolean"
          },
          "addon_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Addon State"
          },
          "authenticated": {
            "default": false,
            "title": "Authenticated",
            "type": "boolean"
          },
          "configured": {
            "title": "Configured",
            "type": "boolean"
          },
          "database": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Database"
          },
          "database_neutralized": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Database Neutralized"
          },
          "ok": {
            "default": false,
            "title": "Ok",
            "type": "boolean"
          },
          "problems": {
            "items": {
              "type": "string"
            },
            "title": "Problems",
            "type": "array"
          },
          "reachable": {
            "default": false,
            "title": "Reachable",
            "type": "boolean"
          },
          "recorder_available": {
            "default": false,
            "title": "Recorder Available",
            "type": "boolean"
          },
          "server_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Server Version"
          },
          "tracing_enabled": {
            "default": false,
            "title": "Tracing Enabled",
            "type": "boolean"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "user_is_admin": {
            "default": false,
            "title": "User Is Admin",
            "type": "boolean"
          },
          "user_login": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Login"
          },
          "version_supported": {
            "default": false,
            "title": "Version Supported",
            "type": "boolean"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "configured"
        ],
        "title": "OdooConnectionStatus",
        "type": "object"
      },
      "StartTraceCommand": {
        "description": "Request to record one workflow run in the user's Odoo.",
        "properties": {
          "context": {
            "additionalProperties": true,
            "title": "Context",
            "type": "object"
          },
          "dry_run": {
            "default": true,
            "title": "Dry Run",
            "type": "boolean"
          },
          "entrypoint_method": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Entrypoint Method",
            "type": "string"
          },
          "entrypoint_model": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Entrypoint Model",
            "type": "string"
          },
          "kwargs": {
            "additionalProperties": true,
            "title": "Kwargs",
            "type": "object"
          },
          "record_ids": {
            "default": [],
            "items": {
              "type": "integer"
            },
            "title": "Record Ids",
            "type": "array"
          }
        },
        "required": [
          "entrypoint_model",
          "entrypoint_method"
        ],
        "title": "StartTraceCommand",
        "type": "object"
      },
      "TraceDetail": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "dry_run": {
            "title": "Dry Run",
            "type": "boolean"
          },
          "entrypoint_method": {
            "title": "Entrypoint Method",
            "type": "string"
          },
          "entrypoint_model": {
            "title": "Entrypoint Model",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "odoo_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Odoo Version"
          },
          "payload": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payload"
          },
          "schema_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema Version"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TraceStatus"
          }
        },
        "required": [
          "id",
          "status",
          "entrypoint_model",
          "entrypoint_method",
          "dry_run",
          "schema_version",
          "odoo_version",
          "started_at",
          "finished_at",
          "created_at",
          "error",
          "payload"
        ],
        "title": "TraceDetail",
        "type": "object"
      },
      "TracePage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TraceSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "TracePage",
        "type": "object"
      },
      "TraceStatus": {
        "description": "Lifecycle of a trace run.",
        "enum": [
          "pending",
          "running",
          "succeeded",
          "failed"
        ],
        "title": "TraceStatus",
        "type": "string"
      },
      "TraceSummary": {
        "description": "Trace metadata without the (potentially large) payload.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "dry_run": {
            "title": "Dry Run",
            "type": "boolean"
          },
          "entrypoint_method": {
            "title": "Entrypoint Method",
            "type": "string"
          },
          "entrypoint_model": {
            "title": "Entrypoint Model",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "odoo_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Odoo Version"
          },
          "schema_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema Version"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TraceStatus"
          }
        },
        "required": [
          "id",
          "status",
          "entrypoint_model",
          "entrypoint_method",
          "dry_run",
          "schema_version",
          "odoo_version",
          "started_at",
          "finished_at",
          "created_at",
          "error"
        ],
        "title": "TraceSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
