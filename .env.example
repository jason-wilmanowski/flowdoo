# Copy to .env and adjust. Never commit .env.

# --- Tool database (service "db") ---
# Holds traces of this tool only. Never point this at an Odoo database.
POSTGRES_USER=flow_tracer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flow_tracer
DB_HOST_PORT=5433
# Async SQLAlchemy URL of the tool database, as seen from the HOST (backend run locally, tests).
# Inside docker compose, "api" gets its own DATABASE_URL pointing at db:5432.
# Tests derive their databases from it (<name>_test, <name>_test_migrations).
DATABASE_URL=postgresql+asyncpg://flow_tracer:change-me@localhost:5433/flow_tracer

# --- API (service "api") ---
API_HOST_PORT=8000
# dry_run=false writes to the Odoo database. Only enable for a disposable dev setup.
ALLOW_NON_DRY_RUN=false
# The api container runs `alembic upgrade head` before starting; false skips that.
RUN_MIGRATIONS=true
# Browser origins allowed to call the API (comma-separated, exact scheme://host:port).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (service "frontend") ---
FRONTEND_HOST_PORT=5173
VITE_API_URL=http://localhost:8000

# --- Connection to the developer's existing Odoo 19 (NOT part of this stack) ---
# Use a DEVELOPMENT database only, never production.
# Odoo on the host / another compose project with published port:
ODOO_URL=http://host.docker.internal:8069
# Odoo on a shared Docker network instead: ODOO_URL=http://<odoo-service-name>:8069
ODOO_DB=change-me
# Optional: the connection check verifies that the API key belongs to this login.
ODOO_LOGIN=admin
# API key of an Odoo user (Preferences > Account Security > New API Key). Used as Bearer
# token for Odoo 19's JSON-2 API. Never logged, never stored in the database.
ODOO_API_KEY=change-me
ODOO_TIMEOUT_SECONDS=10

# --- Test Odoo (profile "test", development/CI only) ---
ODOO_TEST_HOST_PORT=8069
ODOO_TEST_DB_PASSWORD=change-me
# Used by backend integration tests marked "odoo" (pytest -m odoo). Create the database and
# key in the test Odoo first; see backend/tests/integration/odoo/README.md.
ODOO_TEST_URL=http://localhost:8069
ODOO_TEST_DB=odoo_test
ODOO_TEST_API_KEY=change-me
