# Copy to .env (git-ignored) and fill in. Use a neutralised development database only.
ODOO_URL=http://localhost:8069
ODOO_DB=my_dev_database
ODOO_API_KEY=change-me

# Optional: the login the key must belong to
# ODOO_LOGIN=admin
# Optional: seconds to wait for a run (default 30)
# FLOWDOO_TIMEOUT=120
